# Skopiuj do .env i dostosuj:  cp .env.example .env
# .env jest w .gitignore -- nigdy nie commituj prawdziwych kluczy.

# --- Backend HTTP (backend/main.py) ---------------------------------------

# Token chroniący API — WYMAGANY przy starcie backendu.
# Na serwerze ustaw długi losowy ciąg: openssl rand -hex 32
# Backend nie wystartuje, gdy API_TOKEN jest puste i nie ustawiono flagi dev.
API_TOKEN=

# Jedyny sposób na start bez tokenu: jawna flaga LOKALNEGO devu.
# NIGDY nie ustawiaj 1 na serwerze ani w docker compose w produkcji.
# scripts/dev-up.sh ustawia to samo domyślnie dla lokalnego stosu.
O2J_DEV_NO_AUTH=0

# Klucz tylko dla samodzielnych usług OCR (ocr-api serve, local-ai serve).
# Backend go nie potrzebuje; jest rozwiązywany leniwie przy verify_key.
API_KEY=dev-key

# Ścieżka pliku SQLite. W Dockerze montowana jako named volume.
O2J_DB_PATH=work/o2j.db

# Katalog z configs/ (klasy dokumentów, enumy, modele).
O2J_CONFIG_PATH=configs

# Dozwolone originy CORS, rozdzielone przecinkami.
# Puste wartości domyślnie dają http://localhost:3000 (bezpieczne).
# "*" wyłącza allow-credentials.
CORS_ORIGINS=http://localhost:3000

# Port, na którym docker compose wystawia frontend. Na VM-ce organizatora
# otwarte z internetu są tylko 80/443/8000/8080 -> WEB_PORT=8080.
# WEB_PORT=3000

# 1 = odrzucaj (422) JSON-y, które nie przechodzą walidacji Pydantic.
O2J_STRICT_VALIDATION=0

# Limit rozmiaru pliku wysyłanego na /api/analyze (MB). Powyżej -> 413.
# Treść niezaczynająca się od %PDF jest odrzucana kodem 415.
O2J_MAX_UPLOAD_MB=25

# --- Skąd brać tekst dokumentu -------------------------------------------

# text = warstwa tekstowa PDF-a przez pdfplumber (bez GPU, bez wag modelu).
#        Poprawne dla wszystkich 180 dokumentów konkursowych -- domyślne lokalnie.
# cuda = OCR obrazowy na NVIDII (wymaga `uv sync --extra gpu`)
# mlx  = OCR obrazowy na Macu/Metal (wymaga `uv sync --extra local` + wag MLX)
# remote = całe OCR+LLM na innym serwerze (POST /analyze, nagłówek X-API-Key).
#          Wymaga OCR_SERVICE_URL i opcjonalnie OCR_SERVICE_KEY.
WEB_OCR_BACKEND=text

# Ustawienia dla WEB_OCR_BACKEND=remote.
# OCR_SERVICE_URL=http://<L4-IP>:8000
# OCR_SERVICE_KEY=<API_KEY z ocr-api serve>
# OCR_REMOTE_TIMEOUT=900

# Tryb OCR modeli LightOnOCR-3: "" = transkrypcja strony (domyślne),
# "grounding" = etykiety z ramkami współrzędnych (nie do ekstrakcji JSON).
# OCR_PROMPT=""

# Wagi OCR dla `ocr-api serve` (CUDA): domyślnie lightonai/LightOnOCR-3-4B.
# MLX 0.8B z models/ działa tylko przez `local-ai serve` na Macu.
# OCR_MODEL=lightonai/LightOnOCR-3-4B

# 1 = zawsze renderuj i OCR-uj obraz, nawet jeśli PDF ma warstwę tekstową.
# OCR_FORCE_IMAGE=1

# --- Ekstrakcja JSON przez LLM -------------------------------------------

# Puste = brak LLM, /api/analyze zwróci tylko {"raw_text": ...}.
# Włączone = pełny pipeline lab.llm (klasyfikacja + ekstrakcja + walidacja).
OCR_LLM_PROCESSOR=ocr_api.llm_processor:processor

# Profil z configs/models.yaml. Serwer tego profilu musi już działać
# (`lab serve --model local-llm`).
#   local-llm   -> Qwen3-4B, Metal, port 8081  (lokalnie na Macu)
#   qwen3-8b-l4 -> Qwen3-8B, NVIDIA L4, port 8082  (produkcja, też przez
#                  wynajęty serwer GPU -- patrz "Remote GPU box" w
#                  docs/llm-runtime.md: `ssh -L 8082:localhost:8082 ...`
#                  i ten sam profil działa bez zmian w kodzie)
OCR_LLM_MODEL=local-llm

# Limit wywołań LLM w jednej chwili (OCR nadal jest serializowany osobno).
OCR_LLM_CONCURRENCY=1
# 1 = odrzucaj wartości nieobecne w tekście OCR (grounding).
OCR_LLM_GROUND_NULL=0
# Limity w CLI pdf2json i sprawdzaniu health.
OCR_LLM_HEALTH_TIMEOUT=5
OCR_REMOTE_TIMEOUT=900
# Limit rozmiaru PDF-a w samodzielnych usługach OCR (bajty).
OCR_MAX_UPLOAD_BYTES=52428800
